@239  = ~¯egnaj, Sidhe. ¯egnaj, Janie. Nie bójcie siê... w kana³ach widzê wszystko! Byæ mo¿e pewnego dnia po was wrócê.~
@240  = ~ChodŸ, <CHARNAME>. Bêdê na ciebie czeka³ w laboratorium. Zbierz brakuj¹ce mikstury!~
@241  = ~Mo¿e masz racjê, <CHARNAME>. Kobiety nie posiadaj¹ rozumu, a moje badania s¹ wa¿niejsze.~
