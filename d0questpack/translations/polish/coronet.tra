@169  = ~Dobrze wiêc. Po¿yczy³em jej 5000 sztuk z³ota. Otrzyma³a szeœæ dni na sp³atê ³¹cznej kwoty 6250 sztuk z³ota, a teraz mówi, ¿e nie ma tyle.~
@170  = ~W takiej sytuacji moi wspó³pracownicy sk³adaj¹ jej wizytê, przypominaj¹ o koniecznoœci sp³aty i ustalaj¹, czy posiada coœ wartoœciowego, co mo¿e pójœæ na poczet uregulowania rachunków ze mn¹.~
@171  = ~Poza tym, nic jej nie grozi, jeœli tego siê obawia. Nie jestem potworem. Za to jestem bardzo zapracowanym cz³owiekiem i nie mogê ca³ymi dniami konwersowaæ.~
@172  = ~Ponawiam pytanie, czy masz moj¹ nale¿noœæ? Mam doœæ twojego zwlekania.~
@173  = ~Ponawiam pytanie, czy masz moj¹ nale¿noœæ? Nadszed³ termin sp³aty.~
@174  = ~Mi³ego dnia. Nie zapomnij, ¿e masz u mnie d³ug. Bo ja z pewnoœci¹ nie zapomnê.~
@175  = ~Mi³ego dnia. I nie zawracaj mi wiêcej g³owy ka¿d¹ przypadkow¹ kobiet¹, która prosi ciê o pomoc. Mam nadziejê, ¿e weŸmiesz to sobie do serca.~
@176  = ~TY?! Jakim cudem uda³o ci siê œledziæ mnie a¿ tutaj? Niech to szlag! ¯ywcem mnie nie weŸmiesz!~ [d0lend07]
@177  = ~Pozwolisz, ¿e przedstawiê ci swoj¹ now¹ ekipê. Braæ ich!~
@178  = ~Mordobicie za z³oto, co? A tak na wypadek, jakby ta grupa pomagierów siê rozpad³a, jakie s¹ z tego pieni¹dze?~
@179  = ~Oczywiœcie! Nie martw siê o pieni¹dze! Minsc i Boo prêdzej wspiêliby siê na najwy¿sze szczyty Rashemenu w samej bieliŸnie ni¿ zapomnieli ci sp³aciæ d³ug!~

@180 = ~Myœlisz, ¿e uda ci siê wywin¹æ bez sp³acania d³ugu? Lepiej siê nad tym jeszcze raz zastanów! Przybyliœmy, ¿eby zabraæ to, co nale¿y siê naszemu szefowi.~
@181 = ~Myœlisz, ¿e skoro Celile nie ¿yje, nie musisz sp³acaæ swojego d³ugu? Lepiej siê nad tym jeszcze raz zastanów! Przybyliœmy, ¿eby zabraæ to, co nale¿y siê naszemu szefowi.~
@182 = ~Przeka¿esz nam teraz 125 sztuk z³ota albo zabierzemy je z twoich krwawi¹cych zw³ok.~
@183 = ~W porz¹dku. Trzymaj.~
@184 = ~Proszê, weŸcie to! Nie róbcie mi krzywdy!~
@185 = ~Nic nie dostaniesz. Radzê, ¿ebyœ w tej chwili odwróci³ siê na piêcie i st¹d znikn¹³.~
@186 = ~Wybacz, nie mam tyle! Mo¿e siê jakoœ dogadamy?~
@187 = ~Obawiam siê, ¿e w tej chwili nie dysponujê tak¹ sum¹. Daj mi trochê czasu, a wrócê do ciebie z pieniêdzmi.~
@188 = ~Przeka¿esz nam teraz 1250 sztuk z³ota albo zabierzemy je z twoich krwawi¹cych zw³ok.~
@189 = ~Nic nie dostaniesz. Radzê, ¿ebyœ w tej chwili przesta³ mi groziæ i odszed³.~
@190 = ~Przeka¿esz nam teraz 6250 sztuk z³ota albo zabierzemy je z twoich krwawi¹cych zw³ok.~
@191 = ~Przeka¿esz nam teraz 12 500 sztuk z³ota albo zabierzemy je z twoich krwawi¹cych zw³ok.~
@192 = ~Przeka¿esz nam teraz 31 250 sztuk z³ota albo zabierzemy je z twoich krwawi¹cych zw³ok.~
@193 = ~Przeka¿esz nam teraz 62 500 sztuk z³ota albo zabierzemy je z twoich krwawi¹cych zw³ok.~
@194 = ~Dobrze czynisz nie sprzeciwiaj¹c siê. Nasze interesy dobieg³y koñca. Mi³ego dnia.~
@195 = ~Nie jesteœ w pozycji do negocjacji. Jeœli nie dasz nam pieniêdzy, sami je weŸmiemy.~
@196 = ~Nie bêdzie ¿adnych negocjacji. Jeœli nie dasz nam pieniêdzy, sami je weŸmiemy.~
@197 = ~Em, witaj. Czy pomo¿esz kobiecie w potrzebie?~ [d0moiya0] 
@198 = ~Oczywiœcie. Czego ode mnie chcesz?~
@199 = ~Zale¿y, co mi z tego przyjdzie.~
@200 = ~Przykro mi, ale nie mam teraz czasu.~ 
@201 = ~Dlaczego mam pomagaæ takiemu œmieciowi jak ty?~
@202 = ~Jeœli przez "pomoc" rozumiesz "rozprucie flaków", to tak, oczywiœcie.~ 
@203 = ~Och, niech bogowie ci sprzyjaj¹, <PRO_LADYLORD>! Pozwól, ¿e wyjaœniê, o co mi chodzi.~ [d0moiya1]
@204 = ~Na imiê mam Moiya... Jestem biedn¹ kobiet¹. Mój m¹¿ przez jakiœ czas studiowa³ sztuki magiczne, zarabia³ doœæ, byœmy mogli siê razem utrzymaæ. Ale potem pojawili siê Zakapturzeni Czarodzieje.~
@205 = ~Pewnego dnia go zabrali. Powiedzieli, ¿e jest "dewiantem" i zamknêli go w Czarowiêzach. To by³o cztery lata temu, od tej pory go nie widzia³am.~ 
@206 = ~I zosta³am sama, matka z piêciorgiem dzieci. Samiutka. By³o mi ciê¿ko, ale kap³ani ze œwi¹tyni Ilmatera mi pomagali.~
@207 = ~To jednak nie wystarcza³o. Wychowanie dzieci w mieœcie kosztuje, na pewno to rozumiesz. Bardzo potrzebowa³am pieniêdzy, wiêc posz³am do pewnego mê¿czyzny imieniem Celile, ¿eby po¿yczyæ pieni¹dze.~ 
@208 = ~Da³ mi po¿yczkê. Ale nie mam z czego jej sp³aciæ, a on nie jest zbyt ¿yczliwym cz³owiekiem, delikatnie mówi¹c. Nie wiem, co siê stanie, jeœli go nie sp³acê.~
@209 = ~Ile jesteœ mu d³u¿na?~
@210 = ~Có¿ za przypadek. Tak siê sk³ada, ¿e ju¿ go zabi³em.~ ~Có¿ za przypadek. Tak siê sk³ada, ¿e ju¿ go zabi³am.~
@211 = ~Có¿, to nie mój problem. RadŸ sobie sama.~ 
@212 = ~On... nie ¿yje? Nie myœla³am o takim rozwi¹zaniu, <PRO_LADYLORD>. Chyba powinnam ci podziêkowaæ, ale... nie chcê mieæ z tym nic wspólnego. ¯egnaj.~
@213 = ~Chyba nie mam zbyt wiele do zaoferowania. Czy mimo wszystko mnie wys³uchasz?~ 
@214 = ~Oczywiœcie, <PRO_LADYLORD>. Nie chcia³am przeszkadzaæ. Poszukam pomocy gdzie indziej.~ 
@215 = ~Wybacz, <PRO_LADYLORD>. Nie chcia³am przeszkadzaæ. Poszukam pomocy gdzie indziej.~
@216 = ~Proszê, <PRO_LADYLORD>, nie krzywdŸ mnie! Jestem matk¹ z piêciorgiem dzieci! Aaaach!~ 
@217 = ~Po¿yczy³am od niego 5000 sztuk z³ota, a do tego dochodzi jeszcze 1250 sztuk z³ota lichwy. To razem bêdzie...~
@218 = ~Jestem prost¹ kobiet¹! Mój m¹¿ by³ magiem! Ja... eee... 6250 sztuk z³ota razem!~
@219 = ~Mam tyle z³ota, ile potrzebujesz. WeŸ je.~
@220 = ~Nie ma siê o co martwiæ. Tak siê sk³ada, ¿e ju¿ go zabi³em.~ ~Nie ma siê o co martwiæ. Tak siê sk³ada, ¿e ju¿ go zabi³am.~
@221 = ~To ca³kiem sporo. Czego oczekujesz ode mnie?~
@222 = ~Mo¿e uda mi siê z nim porozmawiaæ i dojœæ do jakiegoœ porozumienia?~
@223 = ~Mo¿e... Mo¿e uda³oby ci siê coœ z nim wynegocjowaæ? Sama nie wiem. Mo¿e przekonasz go do wyd³u¿enia terminu? B³agam!~
@224 = ~W porz¹dku, porozmawiam z nim.~
@225 = ~To nie moja sprawa. Sama z nim porozmawiaj.~
@226 = ~Och, dziêkujê! Mo¿e przekonasz go, ¿eby wyd³u¿y³ termin sp³aty?~
@227 = ~To nie brzmi jak trudne zadanie. Dlaczego sama tego nie zrobisz?~
@228 = ~Naprawdê? Dziêki bogom i dziêki tobie za tw¹ szczodroœæ, <PRO_LADYLORD>! Jestem twoj¹ d³u¿niczk¹ na wieki!~
@229 = ~Od razu ruszam, ¿eby pozbyæ siê tego okropnego d³ugu.~ [d0moiya2]
@230 = ~Có¿ za ulga! Celile'a znajdziesz w Miedzianym Diademie. Och, mam nadziejê, ¿e ci siê uda. Tak bardzo siê ba³am... nie mia³am serca powiedzieæ o tym moim dzieciom.~
@231 = ~Nie mogê! Za bardzo siê bojê! Celile to z³y cz³owiek, a ty wygl¹dasz na osobê, która da sobie z nim radê.~
@232 = ~Ciê¿ka sprawa. Nie pomogê ci.~
@233 = ~Ja te¿ nie jestem zbyt ¿yczliw¹ osob¹, wiêc lepiej siê pilnuj!~
@234 = ~Dobra, dobra. Pójdê z nim pogadaæ.~
@235 = ~Nie ma siê czym martwiæ. Tak siê sk³ada, ¿e ju¿ go zabi³em.~ ~Nie ma siê czym martwiæ. Tak siê sk³ada, ¿e ju¿ go zabi³am.~
@236 = ~Och, po prostu weŸ z³oto i idŸ siê z nim zobaczyæ. Ja mam ju¿ doœæ.~
@237 = ~Proszê, pospiesz siê, <PRO_LADYLORD>, porozmawiaj z Celilem.~
@238 = ~Czy uda³o siê porozmawiaæ z Celilem? Co powiedzia³? Czy wszystko jest w porz¹dku?~ [d0moiya3]
@239 = ~Tak, rozmawialiœmy. Mówi, ¿e nie masz siê czego obawiaæ.~
@240 = ~Zmarnowa³aœ mój czas, kobieto. Nie ma ¿adnego problemu. Teraz lepiej zabieraj siê do roboty, ¿eby mieæ z czego sp³aciæ d³ug.~
@241 = ~Naprawdê? Och, wspaniale! Czuje siê teraz znacznie lepiej. Pójdê i bêdê pracowaæ na sp³atê d³ugu. Jeszcze raz dziêkujê!~
@242 = ~Ja... Przepraszam, ¿e zmarnowa³am twój czas. Ale czujê siê lepiej, wiedz¹c, ¿e nie ma problemu. Pójdê i bêdê pracowaæ na sp³atê d³ugu. Jeszcze raz dziêkujê!~
@243 = ~<PRO_LADYLORD>! Pomocy!~
@244 = ~Aaach... uuuch...~
@245 = ~Tak... w... w porz¹dku. To... to byli ludzie Celile'a.~
@246 = ~Eian, biegnij do domu i upewnij siê, czy twoje siostry s¹ bezpieczne. Och, tak mi przykro! Po co w ogóle zadawa³am siê z nim. Biegnij!~
@247 = ~Dobrze. Jestem pewna, ¿e nic im nie jest, ale i tak lepiej ju¿ idŸ. Muszê porozmawiaæ z <MANWOMAN>¹.~
@248 = ~NajwyraŸniej Celile sk³ama³, mówi¹c, ¿e nie mam siê czego obawiaæ. Widzisz z kim mamy tu do czynienia, <PRO_LADYLORD>?~ [d0moiya4]
@249 = ~Powinnam od razu zdaæ sobie sprawê z tego, co z niego za cz³owiek. Powiedzia³ mi o konsekwencjach w przypadku, gdy nie zap³acê. Jestem pewna, ¿e to nie ostatni raz... Och, tak bardzo martwiê siê o moje dzieci!~
@250 = ~Mam Eiana i cztery piêkne dziewczynki. Nie wiem, co zrobiê, jeœli coœ im siê stanie! I co one zrobi¹, jeœli ja zginê? Najpierw ich ojciec, a teraz to!~
@251 = ~Zniknê³a? Jak to mo¿liwe? Na bogów, mam nadziejê, ¿e nic siê jej nie sta³o!~
@252 = ~Jest tak, jak siê obawia³am. (chlip) Celile zna czu³y punkt mojej matki. Có¿ mo¿na zrobiæ? Proszê, <PRO_LADYLORD>, czy pomo¿esz znaleŸæ ma³¹ Carlê? (chlip)~
@253 = ~B³agam, idŸ i porozmawiaj z Celilem, zobacz, czego on chce. Muszê odnaleŸæ moje dziecko!~
@254 = ~Czy... Czy wiadomo coœ ju¿ o mojej Carli, <PRO_LADYLORD>? B³agam, powiedz, ¿e ju¿ coœ wiesz!~ [d0moiya5]
@255 = ~Jeden ze zbirów Celile'a poda³ warunki. Mam jeden dzieñ na sp³atê d³ugu 6250 sztuk z³ota albo dziewczynka zginie.~
@256 = ~D³ug zosta³ sp³acony, odbiorê twoj¹ córkê ze wskazanej kryjówki w jednej z krypt na cmentarzu.~
@257 = ~Uda³o mi siê wydusiæ si³¹ informacjê od jednego ze zbirów Celile'a. Twoja córka jest ukryta w jednej z krypt na cmentarzu.~
@258 = ~D³ug nie zosta³ sp³acony we wskazanym czasie, zbir powiedzia³, ¿e twoja córka ju¿ nie ¿yje.~
@259 = ~Obawiam siê, ¿e twoja córka nie ¿yje. Nie uda³o nam siê jej uratowaæ.~
@260 = ~Przykro mi, jeszcze nic nie wiem.~
@261 = ~Proszê, nie poddawaj siê. Jesteœ jedyn¹ nadziej¹ zrozpaczonej matki! Co wiêcej mogê zrobiæ?~
@262 = ~Zabij¹ j¹? Och... och... musisz ich powstrzymaæ! Jakkolwiek! Zrób, co tylko bêdzie trzeba, proszê!~
@263 = ~W jednej z krypt? Jest martwa? Och... och... mówisz, ¿e tam j¹ tylko przetrzymuj¹. Ach. Dziêki ci! Dziêki ci, <PRO_LADYLORD>!~
@264 = ~Jest martwa? Nie... Nie... Jak powiem o tym reszcie? Tak mi przykro! To wszystko moja wina!~ [d0moiya6]
@265 = ~Dziêki ci, <PRO_LADYLORD>. Wiem, ¿e nic wiêcej nie mo¿na by³o zrobiæ... Teraz jesteœmy rozbit¹ rodzin¹. Muszê ju¿ iœæ, zaj¹æ siê moimi pozosta³ymi dzieæmi. ¯egnaj. (³ka)~ [d0moiya7]
@266 = ~Och, jestem taka szczêœliwa, ¿e Carla jest ca³a i zdrowa! Dziêki ci, <PRO_LADYLORD>. Wybacz, ale nie mam nic, czym mog³abym ci siê odwdziêczyæ za twe czyny. Uda³o ci siê zdj¹æ wielki ciê¿ar z moich barków.~ [d0moiya8]
@267 = ~Skoro Celile'a ju¿ nie ma, moje problemy tak¿e powinny siê skoñczyæ. Znów jesteœmy rodzin¹. Có¿... Prawie. Musze ju¿ iœæ. Jeszcze raz ci dziêkujê!~ [d0moiya9]
@268 = ~¯a³osne. Naziemcy jak zwykle trac¹ czas i œrodki na beznadziejnie s³abe osobniki.~
@269 = ~Szybciej, braæ j¹!~

@270  = ~Ach, <CHARNAME>, jak mniemam? Celile wspomina³, ¿e mo¿esz siê zjawiæ. Chodzi o sprawê tej kobiety, Moiyi, tak?~
@271  = ~Wobec tego pos³uchaj naszych ¿¹dañ. Nale¿ne nam z³oto ma zostaæ zwrócone w ci¹gu dwudziestu czterech godzin albo dziewczynka zginie. Suma, jak zapewne dobrze wiesz, wynosi 6250 sztuk z³ota.~
@272  = ~Bêdê czeka³ w po³udniowej czêœci slumsów, a¿ dostarczysz z³oto. Nie próbuj ¿adnych sztuczek.~
@273  = ~Och, a je¿eli szukasz samego Celile'a, daruj sobie. Nie znajdziesz go w Diademie.~
@274  = ~A wiêc jesteœ. Masz pieni¹dze? Dla dobra tej dziewczynki mam nadziejê, ¿e odpowiedŸ brzmi "tak".~
@275  = ~(Sk³am) Tak, mam je tutaj.~
@276  = ~Nie, ale nied³ugo je zdobêdê.~
@277  = ~Nie dostaniesz ode mnie ¿adnych pieniêdzy!~
@278  = ~Mów, gdzie jest dziewczynka albo ciê zabijê.~
@279  = ~Dobrze. Rych³o w czas. Wobec tego, przeka¿ mi je.~
@280  = ~Oto one.~
@281  = ~W³aœciwie wcale ich nie mam.~
@282  = ~Jak¹ mam gwarancjê, ¿e wypuœcisz dziewczynkê, kiedy oddam ci z³oto?~
@283  = ~Mam tak¹ nadziejê. Tylko dlaczego tu stoisz i ze mn¹ rozmawiasz? Lepiej postaraj siê jak najszybciej uzyskaæ potrzebn¹ sumê.~
@284  = ~Radzê ci to przemyœleæ, jeœli naprawdê zale¿y ci na losie tej dziewczyny. Skoro nie masz pieniêdzy, sugerujê ci nie wracaæ, dopóki to siê nie zmieni.~
@285  = ~Daj spokój. Zabicie mnie nie u³atwi twoich poszukiwañ. Zaatakuj mnie, jeœli chcesz, ale w ten sposób tylko przyspieszysz jej œmieræ.~
@286  = ~W takim razie nie marnuj mojego czasu. Lepiej szukaj funduszy, zamiast urz¹dzaæ sobie pogawêdki.~
@287  = ~To ju¿ twój problem, nie mój. Jednak¿e jestem sk³onny pójœæ na kompromis. Zdradzê ci, ¿e trzymamy j¹ gdzieœ pod ziemi¹. Daj mi z³oto, a powiem gdzie dok³adnie.~
@288  = ~Ach, tak, wszystko siê zgadza. Teraz mo¿emy przejœæ do konkretów. Dziewczyna znajduje siê w Dzielnicy cmentarnej, w jednej z krypt. Poinformujê resztê, ¿eby j¹ uwolnili. Dalej szukaj jej na w³asn¹ rêkê.~
@289  = ~Doœæ! Doœæ! Powiem ci wszystko, co wiem!~
@290  = ~Dziewczynka jest przetrzymywana w jednej z krypt w Dzielnicy cmentarnej! Pilnuj¹ jej przez ca³y czas inni wspó³pracownicy Celile'a.~
@291  = ~A teraz wynoszê siê st¹d!~
@292  = ~Pojawiasz siê zbyt póŸno. Dziewczyna teraz umrze. Tragiczny los, ale mo¿esz winiæ tylko siebie.~
@293  = ~Co do... jak uda³o ci siê nas tu znaleŸæ?~
@294  = ~Ba, a co to w ogóle ma za znaczenie? Zabijmy ich, zanim narobi¹ ha³asu.~
@295 = ~Eee, czeœæ. Kim jesteœ? Czy mama ciê przys³a³a?~
@296 = ~Tak, mo¿esz odejœæ.~
@297 = ~IdŸ, znajdŸ swoj¹ matkê i podziêkuj bogom, ¿e jeszcze ¿yjesz.~
@298 = ~Och, dziêkujê! Tak bardzo siê ba³am...~
@299  = ~Znów bêdzie moja! Nie zabierzecie mi ich!~
@300  = ~Moiya! Moiya!~
@301  = ~Czy ty jesteœ mê¿em Moiyi?~
@302  = ~Znam kobietê imieniem Moiya.~
@303  = ~Moiya! Uuch... (Mê¿czyzna zdaje siê nieœwiadomy s³ów, które do niego kierujesz.) Muszê st¹d uciec. Muszê do niej dotrzeæ... potrzebuj¹ mnie. S¹ w niebezpieczeñstwie!~
@304  = ~Moiya! Wci¹¿ s¹ w moim zasiêgu. Dotrê do nich!~
@305  = ~Hehehe. (beka) Czo³em, kole¿ko. Pomóc w czymœ?~
@306  = ~Kim jesteœ?~
@307  = ~Czyli podaj¹ tu niez³e napitki?~
@308  = ~Um, nie, muszê ju¿ iœæ.~
@309  = ~Ach, tym siê ani trochê nie przejmuj, kole¿ko. Opowiem ci jedn¹ historiê... na pewno zrobi wra¿enie.~
@310  = ~W porz¹dku, zamieniam siê w s³uch.~
@311  = ~W³aœciwie, raczej nie chcê tego s³uchaæ. ¯egnaj.~
@312  = ~Tak jest, kole¿ko. I mocne na dok³adkê. Ale tym siê nie przejmuj. Pozwól, ¿e opowiem ci historiê...zapewniam, ¿e bêdzie epicka.~
@313  = ~Zaczekaj chwilê, kole¿ko. Opowiem ci jedn¹ historiê... na pewno zrobi wra¿enie.~
@314  = ~Dawaj, oby rzeczywiœcie by³a warta mojego czasu.~
@315  = ~Nie, naprawdê muszê ju¿ iœæ.~
@316  = ~Ekhem. (beka) Ach... to by³o kilka nocy temu. Wraca³em sobie w³aœnie po spotkaniu z... eee... kole¿ank¹.~
@317  = ~By³o ciemno. Stra¿nicy w oddali byli zajêci rozmow¹, nie ¿eby kiedykolwiek zajmowali siê pilnowaniem porz¹dku. Skrêca³em za róg, by³em ju¿ mo¿e ze sto kroków od drzwi Diademu, kiedy nagle pojawi³ siê ten goœciu.~
@318  = ~Musia³ mieæ dwa metry, do tego budowê cia³a ogra. Uzna³em, ¿e nie spyta mnie, czy mam jakiœ problem, wiêc po prostu przesz³em obok. Ale, uwa¿aj, on mruczy coœ o zap³aceniu mu tego, co mu siê nale¿y i wali mnie w dziób!~
@319  = ~Zarêczam, nie chcesz oberwaæ od tego goœcia. Krasnoludzki m³ot bêdzie po tym miêkki jak poduszka. Odwróci³em siê akurat ¿eby zobaczyæ, ¿e podbiega jeszcze dwóch kolejnych.~
@320  = ~Ale ¿aden z nich, powtarzam, ¿aden, nie wiedzia³ z kim w³aœnie zadarli. Robi³em uniki i piruety, zadaj¹c szybkie ciosy. By³em gibki jak elf, giêtki jak krêgos³up moralny urzêdnika, dopóki jeden z nich mnie nie z³apa³.~
@321  = ~Mia³ si³ê dziesiêciu mê¿czyzn, tak¿e nawet ja nie mog³em drgn¹æ w jego ¿elaznym uœcisku. Zaczêli biæ...twarz mia³em ca³¹ we krwi. Zobaczy³em, ¿e jeden ze stra¿ników zmierza w nasz¹ stronê, oni uciekli, zostawiaj¹c mnie w b³ocie.~
@322  = ~Jakoœ tu siê doczo³ga³em i musia³em siê trochê wzmocniæ tutejszymi specja³ami, ¿eby stan¹æ na nogi. Ale nigdy wiêcej... Nie ruszam siê st¹d, dopóki mnie nie wyrzuc¹.~
@323  = ~To by³o, hmm, bardzo interesuj¹ce. Wiesz coœ o ludziach, którzy ciê zaatakowali?~
@324  = ~Co za bzdury! Siedzia³em tu dla czegoœ takiego?~ ~Co za bzdury! Siedzia³am tu dla czegoœ takiego?~
@325  = ~Jak tam chcesz. Twoja strata.~
@326  = ~Hmm...Moja opowieœæ bêdzie potrzebowaæ tytu³u, jeœli bêdê chcia³ j¹ wydaæ. Ach... (beka)~
@327  = ~Zauwa¿y³eœ mo¿e coœ podejrzanego w okolicy?~
