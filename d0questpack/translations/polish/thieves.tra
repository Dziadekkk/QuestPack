@483 = ~Wo... wolny... ufff... Achhhhh... chh... hm...~
@484 = ~Ach, <CHARNAME>. G³ówny Inspektor Brega mówi³, ¿e mo¿emy siê ciebie spodziewaæ. Có¿, myœlê, ¿e wiesz, o co chodzi. Zaczynajmy wiêc. Na chwa³ê Amn!~
@485 = ~Kryjówka Linvaila znajduje siê poni¿ej tej sali. Niedaleko st¹d jest sekretne przejœcie, które ju¿ zosta³o otwarte. Sugerujê, byœ bez zw³oki wyruszy³<PRO_HESHE> na dó³.~
@486 = ~Kryjówka Linvaila znajduje siê poni¿ej tej sali. Niedaleko st¹d jest sekretne przejœcie. Rozumiem, ¿e jesteœ w posiadaniu klucza, który umo¿liwi jego otwarcie. Sugerujê, byœ zrobi³<PRO_HESHE> to niezw³ocznie.~
@487 = ~Kryjówka Linvaila znajduje siê poni¿ej tej sali. Niedaleko st¹d jest sekretne przejœcie, ale nie uda³o nam siê jeszcze odnaleŸæ sposobu, by je otworzyæ. Sugerujê, byœ przeszuka³<PRO_HESHE> salê. Któryœ z tych wy¿ej postawionych z³odziei musia³ mieæ klucz.~
@488 = ~Linvail musi gdzieœ tam byæ. <CHARNAME>, my zostaniemy tutaj i powstrzymamy nadchodz¹ce posi³ki, a tobie sugerujê, byœ ruszy³<PRO_HESHE> go odnaleŸæ.~
@489 = ~Doskonale! Nasza misja jest zakoñczona, ale musimy pozostaæ na miejscu, by zabezpieczyæ teren. Sugerujê, byœ uda³<PRO_HESHE> siê do G³ównego Inspektora, by poinformowaæ go o naszym sukcesie.~
@490 = ~Ach, <CHARNAME>. Oddzia³y Bregi zosta³y odes³ane z powrotem, a ten budynek z rozkazu Rady zosta³ poddany kwarantannie. Ruszaj st¹d.~
@491 = ~Ach, jestem zaskoczony, ¿e zaszed³eœ tak daleko. Obawiam siê jednak, ¿e twoja ma³a inwazja tutaj siê zakoñczy!~
@492 = ~Ach, jestem zaskoczony, ¿e zaszliœcie tak daleko, zdrajcy. Obawiam siê jednak, ¿e wasza rebelia tutaj siê zakoñczy!~
@493 = ~Ty... kimkolwiek jesteœ! Zabij tego przeklêtego oprawcê i mnie uwolnij! £apacz ma klucze! Powiem ci wszystko, co wiem!~
@494 = ~Ty... kimkolwiek jesteœ! Proszê, wypuœæ mnie! Mogê ci pomóc w przedarciu siê do Linvaila!~
@495 = ~A kim ty w ogóle jesteœ?~
@496 = ~Spokojnie! Mnie te¿ zale¿y na jego œmierci, ale najwyraŸniej ostrze¿ono go o twoim ataku i zd¹¿y³ przygotowaæ siê do obrony.~
@497 = ~Co do klucza, to obawiam siê, ¿e nie wiem, gdzie móg³by byæ. Mo¿e u któregoœ z zaufanych doradców Arana.~
@498 = ~W ka¿dym b¹dŸ razie jestem cokolwiek w nienajlepszej kondycji, wiêc raczej ciê opuszczê. ¯yczê szczêœcia. I dziêki za uratowanie mnie.~
@499 = ~Jestem Tizzak. Zanim Bodhi mnie zrekrutowa³a, by³em Z³odziejem Cienia. Po upadku tamtej gildii ludzie Arana œcigali mnie bez wytchnienia. Ale zamiast zwyczajnie mnie zabiæ, Linvail wiêzi³ mnie i torturowa³, jako ostrze¿enie dla innych.~
@500 = ~Niezale¿nie od tego, z jakich tu jesteœ powodów, wierzê, ¿e mogê ci pomóc pokonaæ Arana. Mnie te¿ zale¿y na jego œmierci, ale najwyraŸniej ostrze¿ono go o twoim ataku i zd¹¿y³ przygotowaæ siê do obrony.~
@501 = ~Ach, wiêc przychodzicie po mnie? Jak¿e ja mog³em tego nie przewidzieæ?~
@502 = ~Tak, przychodzimy po ciebie, Aranie. Twoje rz¹dy w Athkatli trwaj¹ ju¿ wystarczaj¹co d³ugo i na wszystko, co prawe, ju¿ czas je zakoñczyæ.~
@503 = ~Ach, Keldornie, czy to tak teraz dzia³a Zakon? Najpierw <CHARNAME> ³¹czy ze mn¹ si³y, a teraz wbijacie mi nó¿ w plecy? Pasowa³byœ do nas jak ula³.~
@504 = ~Twoje drwiny trafiaj¹ w pró¿niê. W imiê Torma, wymierzê ci sprawiedliwoœæ.~
@505 = ~Nawet Imoen. Jestem rozczarowany. To tak okazujesz mi wdziêcznoœæ?~
@506 = ~Cieszê siê, ¿e zechcia³eœ pomóc w uratowaniu mnie, ale to nie zwalnia ciê z odpowiedzialnoœci za ca³e z³o, które czynisz.~
@507 = ~Nie zwracaj na niego uwagi, dziecko. Pomaga³ nam, bo byliœmy mu potrzebni. W innych okolicznoœciach nie zawaha³by siê ani chwili, ¿eby post¹piæ tak, jak jemu wygodnie.~
@508 = ~Mog³eœ siê tego spodziewaæ, Linvailu, bo to ju¿ najwy¿szy czas, ¿ebyœ posmakowa³ swoich w³asnych zdradzieckich metod.~
@509 = ~Mog³eœ siê tego spodziewaæ, Linvailu, bo to ju¿ najwy¿szy czas, ¿ebyœmy oczyœcili to legowisko zgni³ego zepsucia.~
@510 = ~Jesteœ wyj¹tkowo pod³¹ istot¹, Aranie, drêczysz i drwisz ze swoich nieprzyjació³ do samego koñca. Nie bêdê odczuwa³ wyrzutów sumienia z powodu pomszczenia wszystkich tych, których skrzywdzi³eœ.~
@511 = ~Ju¿ czas, Aranie. Nie bêdê odczuwa³ wyrzutów sumienia z powodu pomszczenia wszystkich tych, których skrzywdzi³eœ.~
@512 = ~Wobec tego zobaczmy, kto siê oka¿e zwyciêzc¹!~
