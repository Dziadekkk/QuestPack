@336 = ~To doprawdy dobra wiadomoœæ, chocia¿ nie spodziewam siê, ¿eby to by³ koniec moich zatargów z Nocnymi Maskami.~
@337 = ~Podejrzewam, ¿e oczekujesz jakiejœ nagrody. I dobrze, to wydaje siê byæ rozs¹dne podejœcie. Mo¿esz wzi¹æ te zaklête rêkawice i nauczyæ siê doceniaæ ich posiadanie.~
@338 = ~A teraz mnie zostaw. Mam wreszcie mo¿liwoœæ kierowania dzia³aniami Z³odziei Cienia w Athkatli. Bardzo satysfakcjonuj¹ce zakoñczenie.~
@339 = ~To znowu ty? Powinieneœ ju¿ wiedzieæ, ¿e nie nale¿y marnowaæ mojego czasu. Mam tu sprawy, które wymagaj¹ mojej uwagi.~ ~To znowu ty? Powinnaœ ju¿ wiedzieæ, ¿e nie nale¿y marnowaæ mojego czasu. Mam tu sprawy, które wymagaj¹ mojej uwagi.~
@340 = ~Wkrótce mo¿emy zdobyæ jeszcze wiêksz¹ w³adzê nad Rad¹ tego miasta. Ten g³upiec Aran nigdy by tego nie wymyœli³.~
@341 = ~Dobrze by by³o, ¿ebyœ nikomu nie opowiada³<PRO_HESHE>, co tu siê wydarzy³o. Chyba ju¿ wiesz, jak traktujê tych, którzy mnie zdradz¹.~
@342 = ~Doprawdy wspaniale. <CHARNAME>, doskona³a robota. Wraz z odejœciem Mae'Vara, Renala i Linvaila koñczy siê panowanie Z³odziei Cienia w Athkatli.~ [d0night6]
@343 = ~Rozpoczynaj¹ siê tu rz¹dy Nocnych Masek. <CHARNAME>, doceniamy w tym twoj¹ rolê. I wiedz... ¿e wynagradzamy naszych sojuszników.~
@344 = ~Ale teraz muszê prosiæ ciê o odejœcie, gdy¿ nadszed³ czas umacniania mojej pozycji. Mi³ego dnia.~
@345 = ~<CHARNAME>, doceniamy twoj¹ pomoc. Jak mówiliœmy, Nocne Maski umacniaj¹ swoj¹ pozycjê w mieœcie.~
@346 = ~Mae'Var by³ u¿ytecznym pionkiem, ale ostatecznie trzeba go by³o usun¹æ. Masz szczêœcie, ¿e nie uznaliœmy za s³uszne, byœ podzieli³ <PRO_HESHE> jego los.~
@347 = ~Bez dwóch zdañ Aran mia³ tu niez³e lokum. Bêdzie siê nadawaæ na bazê wypadow¹ dla naszych operacji.~
@348 = ~Cofnij siê, g³upcze. Nie wiesz, kim jesteœmy?~ ~Cofnij siê, g³upia. Nie wiesz, kim jesteœmy?~
@349 = ~Och, potrzebujesz nas, prawda? Nie jesteœmy twoimi niewolnikami i masz szczêœcie, ¿e <CHARNAME> podj¹³ siê odwalenia dla ciebie tej brudnej roboty. Ja bym tego na pewno nie zrobi³a.~ ~Och, potrzebujesz nas, prawda? Nie jesteœmy twoimi niewolnikami i masz szczêœcie, ¿e <CHARNAME> podjê³a siê odwalenia dla ciebie tej brudnej roboty. Ja bym tego na pewno nie zrobi³a.~
@350 = ~Nie mo¿esz siê zdecydowaæ, po której stronie stan¹æ? Mo¿e to ja powinienem podejmowaæ decyzje za tê grupê, skoro tobie sprawia to tyle problemów?~
@351 = ~Boo jest zniesmaczony tym pokazem nieuczciwoœci! Z³o powinno siê kopaæ twarz¹ w twarz, a nie z ukrycia! Chocia¿ z ukrycia jest lepsze, ni¿ nic.~
@352 = ~Jeœli dziêki temu pozbêdziemy siê choæby tylko kilku spoœród tych nikczemnych z³odziei z Doków, to byæ mo¿e, tak bêdzie najlepiej, Minscu. Powiem ci, ¿e doœæ ju¿ mam tych przeklêtych wojen gildii. Najchêtniej ujrza³bym ich wszystkich jak p³on¹ w Dziewiêciu Piek³ach.~
@353 = ~Nie jest to dla mnie zaskoczeniem, ¿e takie metody s¹ poza zasiêgiem twojego rozumowania, mój inteligentny inaczej towarzyszu. To w³aœnie dlatego ka¿dego dnia ty pogr¹¿asz siê tym twoim patetycznym be³kotem, a ja oddajê siê zg³êbianiu sztuki magicznej, której z³o¿onoœæ przystêpna jest dla nielicznych.~
@354 = ~<CHARNAME>, nie przejmuj siê t¹ pó³rozumn¹ t³uszcz¹. Od dawna by³o wiadomo, ¿e Mae'Vara nie minie kara, a mnie a¿ œwierzbi, by daæ tym aroganckim intrygantom nauczkê.~
@355 = ~<CHARNAME>, lepiej siê z tym poœpiesz. Wieœæ o tej bitwie wkrótce dotrze do Mae'Vara i bêdzie lepiej, jeœli dotrzemy tam przed ni¹.~
@356 = ~Ci przeklêci zniewieœciali z³odzieje uczynili ze zdradzania prawdziw¹ sztukê. To pewnie jedyna dobra rzecz, jak¹ mo¿na o nich powiedzieæ.~
@357 = ~Mae'Var's wzywa

Mae'Var przys³a³ pos³añca, abyœmy jak najszybciej stawili siê w jego gildii. Nie znamy powodów tego spotkania, ale mo¿e ma dla nas jakieœ zadanie.~
@358 = ~Mae'Var's wzywa

Mae'Var jest bardziej ambitny, ni¿ mog³oby siê zdawaæ. Chce odwróciæ równowagê si³ w Athkatli poprzez zamordowanie Mistrza Cieni Arana Linvaila. Mamy spotkaæ siê z Larellem w gildii Renala i wspomóc go podczas ataku na Linvaila.~ 
