@379 = ~Rozumiem. Œwietnie to rozegra³eœ, bior¹c pod uwagê, ¿e na Promenadzie zosta³eœ doszczêtnie rozgromiony.~
@380 = ~Gdybyœmy nie zaatakowali, wci¹¿ by³byœ tam uwiêziony. To, czego by³eœ œwiadkiem po swoim uwolnieniu, by³o tylko zakoñczeniem d³u¿szego konfliktu.~ ~Gdybyœmy nie zaatakowali, wci¹¿ by³abyœ tam uwiêziona. To, czego by³aœ œwiadkiem po swoim uwolnieniu, by³o tylko zakoñczeniem d³u¿szego konfliktu.~
@381 = ~<CHARNAME>? Mam dla ciebie wiadomoœæ. G³ówny Inspektor Brega chcia³by z tob¹ porozmawiaæ w budynku Rady. Wierzy, ¿e przychylisz siê do jego proœby.~
@382 = ~Wobec tego powiedz mu, ¿e siê tam udam.~
@383 = ~Chêtnie bym odpowiedzia³ na jego wezwanie, ale jestem teraz zbyt zajêty.~ ~Chêtnie bym odpowiedzia³a na jego wezwanie, ale jestem teraz zbyt zajêta.~
@384 = ~Nie, nie mam czasu dla G³ównego Inspektora Bregi. Muszê siê zaj¹æ swoimi w³asnymi sprawami.~
@385 = ~Doskonale. Zaskarbisz tym sobie jego wdziêcznoœæ. Bêdzie oczekiwa³ twojego przybycia.~
@386 = ~Bêdzie wiêc musia³ mieæ nadziejê, ¿e znajdziesz dla niego jak¹œ woln¹ chwilê w najbli¿szej przysz³oœci. Bêdzie oczekiwa³ twojego przybycia mimo wszystko.~
@387 = ~Wobec tego bêdzie niepocieszony. Gdybyœ jednak zmieni³<PRO_HESHE> zdanie, to myœlê, ¿e znajdziesz go z ³atwoœci¹ w budynku Rady.~
@388 = ~Jestem ju¿ gotów, by pomóc ci w ataku na Z³odziei Cienia.~ ~Jestem ju¿ gotowa, by pomóc ci w ataku na Z³odziei Cienia.~
@389 = ~Ach, <CHARNAME>, mia³em nadziejê, ¿e przyjdziesz. G³ówny Inspektor Brega, do us³ug. Z ramienia Rady zajmujê siê sprawami kryminalnymi w tym mieœcie. I uwierz mi, ¿e jest ich ca³kiem sporo.~
@390 = ~To jest zreszt¹ powód, dla którego ciê tutaj wezwa³em. Jest pewna szczególna kwestia, która zaprz¹ta moj¹ uwagê ju¿ od jakiegoœ czasu.~
@391 = ~Zapewne do tej pory dowiedzia³eœ siê ju¿ o obecnoœci Z³odziei Cienia w Athkatli. To powszechna wiedza, chocia¿ Rada od zawsze trwa w przekonaniu, ¿e ich dzia³alnoœæ jest pod nasz¹ œcis³¹ kontrol¹.~ ~Zapewne do tej pory dowiedzia³aœ siê ju¿ o obecnoœci Z³odziei Cienia w Athkatli. To powszechna wiedza, chocia¿ Rada od zawsze trwa w przekonaniu, ¿e ich dzia³alnoœæ jest pod nasz¹ œcis³¹ kontrol¹.~
@392 = ~Ca³kowite wyeliminowanie Z³odziei Cienia by³oby niepraktyczne, ale ostatnio stali siê oni jednak zbyt uci¹¿liwi. A Rada wci¹¿ przymyka na to oko. Muszê zatem zareagowaæ wbrew jej oczekiwaniom i wyst¹piæ przeciw z³odziejskiej gildii.~
@393 = ~Mów dalej.~
