@409 = ~Mam pewne wspólne interesy ze Z³odziejami Cienia. Nie pomogê ci.~
@410 = ~Nie, nie zamierzam siê w to mieszaæ.~
@411 = ~Nie spodziewa³em siê, ¿e ktoœ taki, jak ty mo¿e mieæ zwi¹zki ze Z³odziejami Cienia. Niewa¿ne. Radzê ci jednak, byœ to zakoñczy³<PRO_HESHE> zanim siê nimi kiedyœ wreszcie zajmiemy. Mi³ego dnia.~
@412 = ~Dobrze wiêc. Byæ mo¿e podejmiemy jakieœ dzia³ania w najbli¿szej przysz³oœci... z tob¹, czy bez ciebie.~
@413 = ~Radzê ci jednak byœ to zakoñczy³<PRO_HESHE> zanim siê nimi kiedyœ wreszcie zajmiemy. Mi³ego dnia.~
@414 = ~Sprawiedliwoœæ dla Linvaila jeszcze siê nie dokona³a. <CHARNAME>, musisz siê spieszyæ!~
@415 = ~W takim razie pójdê ju¿.~
@416 = ~Niewiele. Tym dochodzeniem zajmuje siê porucznik Aegisfield z Dzielnicy mostów. Mogê ci tylko poradziæ, byœ bacznie na siebie uwa¿a³<PRO_HESHE>, gdy siê tam krêcisz po nocy.~
@417 = ~Tymczasem zaleca³bym skupienie siê na zadaniu, o którym mówiliœmy. To godne pochwa³y, ¿e przej¹³eœ siê tymi morderstwami, ale Z³odzieje Cienia s¹ teraz bardziej pal¹cym problemem.~ ~Tymczasem zaleca³bym skupienie siê na zadaniu, o którym mówiliœmy. To godne pochwa³y, ¿e przejê³aœ siê tymi morderstwami, ale Z³odzieje Cienia s¹ teraz bardziej pal¹cym problemem.~
@418 = ~Uwa¿asz, ¿e te liczne morderstwa nie s¹ istotne?~
@419 = ~Nie, oczywiœcie, ¿e s¹. I ka¿da pomoc bêdzie na wagê z³ota. Mimo tego bardzo mi zale¿y, aby Z³odziei Cienia dosiêg³a wreszcie sprawiedliwoœæ.~
@420 = ~W takim razie mam nadziejê, ¿e uda mi siê pomóc w obu tych sprawach.~
@421 = ~Wiêc Linvail jest martwy, a jego wiêŸniowie wolni. Z ca³¹ pewnoœci¹ odda³eœ miastu ogromn¹ przys³ugê. Mam nadziejê, ¿e uznasz to wynagrodzenie za godne twoich wysi³ków.~ ~Wiêc Linvail jest martwy, a jego wiêŸniowie wolni. Z ca³¹ pewnoœci¹ odda³aœ miastu ogromn¹ przys³ugê. Mam nadziejê, ¿e uznasz to wynagrodzenie za godne twoich wysi³ków.~
@422 = ~Wierzê, ¿e na jakiœ czas ograniczyliœmy mo¿liwoœci dzia³ania Z³odziei Cienia w tym mieœcie. Nie ³udŸ siê jednak, ¿e to ju¿ koniec naszych z nimi problemów.~
@423 = ~Jeszcze raz dziêkujê za pomoc. Jestem ci niezmiernie wdziêczny. Wiedz jednak, ¿e Rada ju¿ siê o wszystkim dowiedzia³a i nie jest zbytnio zadowolona. Nie zamartwiaj siê tym jednak, poradzê sobie z nimi.~
@424 = ~Rozwik³a³em tak¿e zagadkê morderstw w Dzielnicy mostów. By³ za nie odpowiedzialny garbarz Rejiek. Zabi³ tak¿e porucznika Aegisfielda. Oto jego cia³o.~ ~Rozwik³a³am tak¿e zagadkê morderstw w Dzielnicy mostów. By³ za nie odpowiedzialny garbarz Rejiek. Zabi³ tak¿e porucznika Aegisfielda. Oto jego cia³o.~
@425 = ~Rozwik³a³em tak¿e zagadkê morderstw w Dzielnicy mostów. By³ za nie odpowiedzialny garbarz Rejiek. Zabi³ tak¿e porucznika Aegisfielda.~ ~Rozwik³a³am tak¿e zagadkê morderstw w Dzielnicy mostów. By³ za nie odpowiedzialny garbarz Rejiek. Zabi³ tak¿e porucznika Aegisfielda.~
@426 = ~Mam tu tak¿e g³owê dzieciobójcy Neba. Jest martwy i nikomu ju¿ wiêcej nie zaszkodzi.~
@427 = ~Mam tu tak¿e g³owê gnoma dzieciobójcy, Neba. Oczekujê nagrody za jego wyeliminowanie.~
@428 = ~Dlaczego Rada nie ¿yczy³a sobie ¿adnych dzia³añ wymierzonych przeciwko Z³odziejom Cienia?~
@429 = ~Modlê siê, by nic gorszego nie czai³o siê w cieniach, by przej¹æ po nim w³adzê. Musimy pozostaæ czujni.~
@430 = ~Wiêc Linvail jest martwy i sprawiedliwoœci sta³o siê wreszcie zadoœæ. Z ca³¹ pewnoœci¹ odda³eœ miastu ogromn¹ przys³ugê. Mam nadziejê, ¿e uznasz to wynagrodzenie za godne twoich wysi³ków.~ ~Wiêc Linvail jest martwy i sprawiedliwoœci sta³o siê wreszcie zadoœæ. Z ca³¹ pewnoœci¹ odda³aœ miastu ogromn¹ przys³ugê. Mam nadziejê, ¿e uznasz to wynagrodzenie za godne twoich wysi³ków.~
@431 = ~<CHARNAME>, sugerujê, byœ uda³<PRO_HESHE> siê do Doków, zanim przedstawiciele Rady zd¹¿¹ siê wmieszaæ w nasze sprawy.~
@432 = ~<CHARNAME>, nie wiem, co wydarzy³o siê w Dokach, ale wiem, ¿e czeka mnie d³uga spowiedŸ przed Rad¹.~
@433 = ~Wp³ywy Linvaila siêgaj¹ znacznie dalej, ni¿ móg³byœ siê spodziewaæ. Decyzje Rady... nie zawsze podejmowane s¹ w najlepszym interesie miasta.~ ~Wp³ywy Linvaila siêgaj¹ znacznie dalej, ni¿ mog³abyœ siê spodziewaæ. Decyzje Rady... nie zawsze podejmowane s¹ w najlepszym interesie miasta.~
@434 = ~Rozumiem. Czy nie da siê z tym nic zrobiæ?~
@435 = ~Ach, to wszystko wyjaœnia.~
@436 = ~Rada jest skorumpowana? Musimy po³o¿yæ temu kres!~
@437 = ~Niestety nie. Nie da siê niczego osi¹gn¹æ, wystêpuj¹c przeciwko Radzie. Czasami tylko udaje mi siê nagi¹æ jej decyzje do moich, s³u¿¹cych jedynie sprawiedliwoœci celów.~
@438 = ~Powtórzê raz jeszcze, naprawdê doceniam twoj¹ pomoc. I ¿yczê szczêœcia w twoich dalszych podró¿ach.~
@439 = ~Dziêkujê. Modlê siê, by nic gorszego nie czai³o siê w cieniach, by przej¹æ po nim w³adzê. Musimy pozostaæ czujni.~
@440 = ~To prawda. No, ale nie zatrzymujê ciê d³u¿ej.~
@441 = ~Czasami tylko udaje mi siê nagi¹æ jej decyzje do moich, s³u¿¹cych jedynie sprawiedliwoœci celów.~
@442 = ~S³ysza³em co nieco o twoich czynach. Twoje imiê jest ju¿ doœæ znane w mieœcie i podejrzewam, ¿e jesteœ w stanie mi pomóc.~
@443 = ~Sami stra¿nicy nie mog¹ siê równaæ ze Z³odziejami Cienia. Gdybyœ zechcia³<PRO_HESHE> im pomóc, odda³<PRO_HESHE>byœ miastu ogromn¹ przys³ugê. Nawet jeœli sta³oby siê to wbrew woli Rady.~
@444 = ~Jakkolwiek fascynuj¹ce by siê nie wydawa³o usuniêcie Linvaila, to pamiêtaj, ¿e ka¿dy pionek, którego wystawimy przeciw Bodhi, mo¿e okazaæ siê tym decyduj¹cym. Sugerujê, byœ oszacowa³<PRO_HESHE>, co ci siê bardziej op³aca.~
@445 = ~<CHARNAME>, jeœli mamy usun¹æ Arana, to mo¿e powinniœmy najpierw za³atwiæ sprawê z Bodhi. W przeciwnym razie utracimy jedn¹ z si³ zdolnych stawiæ czo³a rozlewaj¹cej siê fali jej wampiryzmu.~
@446 = ~<CHARNAME>, poradziliœmy sobie z Bodhi, wiêc myœlê, ¿e najwy¿szy czas zaj¹æ siê Z³odziejami Cienia.~
@447 = ~S³usznie, nadszed³ czas dzia³ania. Polityczne wp³ywy Arana nie uchroni¹ go przed karz¹c¹ rêk¹ sprawiedliwoœci.~
@448 = ~To ci ludzie, którzy pomogli mnie uratowaæ, prawda? A my zamierzamy ich zabiæ... Có¿, skoro s¹ a¿ tak Ÿli, to pewnie nie mamy wyboru.~
@449 = ~Och, ale musimy uratowaæ ich wiêŸniów! Oni... oni ich torturuj¹! Musimy coœ zrobiæ, dopóki mamy tak¹ mo¿liwoœæ.~
@450 = ~Jakiego rodzaju nagrodê przewidziano za wykonanie tego zadania?~
@451 = ~S³ysza³em co nieco o twoich czynach. I jako ¿e nie s¹ to wzorcowe dzia³ania, to podejrzewam, ¿e bêdziesz w stanie mi pomóc w tej konkretnie sprawie.~
@452 = ~Stra¿nicy maj¹ wystarczaj¹co du¿o problemów ze Z³odziejami Cienia, nawet jeœli nie próbuj¹ zupe³nie ich wyeliminowaæ.~
@453 = ~Zapewniam ciê, ¿e zostaniesz odpowiednio wynagrodzony. S³ysza³em co nieco o twoich czynach. Twoje imiê jest ju¿ doœæ znane w mieœcie i podejrzewam, ¿e jesteœ w stanie mi pomóc.~ ~Zapewniam ciê, ¿e zostaniesz odpowiednio wynagrodzona. S³ysza³em co nieco o twoich czynach. Twoje imiê jest ju¿ doœæ znane w mieœcie i podejrzewam, ¿e jesteœ w stanie mi pomóc.~
@454 = ~Zapewniam ciê, ¿e zostaniesz odpowiednio wynagrodzony. S³ysza³em co nieco o twoich czynach. I jako ¿e nie s¹ to wzorcowe dzia³ania, to podejrzewam, ¿e bêdziesz w stanie mi pomóc.~ ~Zapewniam ciê, ¿e zostaniesz odpowiednio wynagrodzona. S³ysza³em co nieco o twoich czynach. I jako ¿e nie s¹ to wzorcowe dzia³ania, to podejrzewam, ¿e bêdziesz w stanie mi pomóc.~
@455 = ~Czy wiesz, ¿e G³ówny Inspektor Brega podj¹³ dzia³ania wymierzone przeciwko Z³odziejom Cienia?~
@456 = ~Co? Przecie¿ Rada wyraŸnie mu tego zabroni³a. Ja... muszê ich zaraz poinformowaæ o tym, co tu siê dzieje.~
@457 = ~Dziêkujê, ¿e zwróci³eœ na to moj¹ uwagê. Natychmiast wyœlê oddzia³y, by powstrzymaæ plany Bregi... Modlê siê, by nie by³o za póŸno.~ ~Dziêkujê, ¿e zwróci³aœ na to moj¹ uwagê. Natychmiast wyœlê oddzia³y, by powstrzymaæ plany Bregi... Modlê siê, by nie by³o za póŸno.~
@458 = ~Na szczêœcie zd¹¿yliœmy powstrzymaæ ludzi Bregi. <CHARNAME>, doceniamy twoj¹ w tym rolê. Rada jest ci naprawdê wdziêczna.~
@459 = ~Aran nie ¿yje. Mo¿esz odejœæ. Tylko na siebie uwa¿aj.~
@460 = ~Aran wkrótce bêdzie martwy. Mo¿esz odejœæ. Tylko na siebie uwa¿aj.~
@461 = ~Jestem tu, by was uwolniæ. Zmiataj st¹d, ³achmaniarzu.~
@462 = ~Achhh, daj mi spokój. No, chyba ¿e masz tam jakiœ smakowity k¹sek... Masz jakiœ?~
@463 = ~Uwolniæ nas? Co ty nawijasz? Aran zapomnia³ o mnie lata temu, nie w g³owie mu uwalnianie mnie.~
@464 = ~Aran nie ma tu ju¿ nic do powiedzenia. Zmiataj st¹d.~
@465 = ~Naprawdê? Modli³em siê o nadejœcie tego dnia... dziêkujê, <LADYLORD>!~
@466 = ~S³yszeliœcie, przyjaciele? Aran nie ¿yje! Spadajmy st¹d!~
@467 = ~Nieszczêsne istoty! <CHARNAME>, tak siê cieszê, ¿e przybyliœmy tutaj, by ich oswobodziæ!~
@468 = ~Nieszczêsne istoty! <CHARNAME>, musimy ich ratowaæ, skoro ju¿ tu jesteœmy!~
@469 = ~Uwolniæ nas? Czy to mo¿liwe, ¿e ujrzê jeszcze œwiat³o dnia? Powiedz, ¿e tak!~
@470 = ~Dok³adnie tak. Zmiataj st¹d, ³achmaniarzu.~
@471 = ~Naprawdê? Modli³em siê o dzieñ, w którym bêdê móg³ znowu ujrzeæ s³oñce na niebie... dziêki ci, <LADYLORD>!~
@472 = ~Dobra, czego ty chcesz?~
@473 = ~Jesteœ tu, by nas uwolniæ? Czy to mo¿liwe, ¿e ujrzê jeszcze œwiat³o dnia? Powiedz, ¿e tak!~
@474 = ~Bez w¹tpienia zas³ugiwa³eœ na tê karê. To smutne, ¿e ju¿ wkrótce to miejsce bêdzie jeszcze bardziej puste.~
@475 = ~Marny to koniec... Tak wiele czasu na przemyœlenia, a jednak to mo¿liwoœæ ucieczki staje siê Ÿród³em duchowego ukojenia.~
@476 = ~Dalej nie przejdziesz! Z³odzieje Cienia nigdy siê nie poddadz¹!~
@477 = ~Aran nie ma tu ju¿ nic do gadania. Zmiataj st¹d, ³achmaniarzu.~
@478 = ~Co to za zamieszanie za drzwiami? Co tam siê dzieje?~
@479 = ~Uwolniæ nas? A wiêc o to chodzi. Bogom niech bêd¹ dziêki, jeœli w koñcu przyszed³ czas na Arana.~
@480 = ~Naprawdê? Tak d³ugo modli³em siê o nadejœcie tego dnia. No, ale nie zamierzam tu sterczeæ. Dziêki i do widzenia!~
@481 = ~Rozejrzyj siê! Aran Linvail nie ¿yje, a ty jesteœ wolny!~
