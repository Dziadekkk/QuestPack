@269  = ~Có¿, zobaczmy zatem, kto zostanie zwyciêzc¹!~
@270  = ~Zostaniesz, oczywiœcie, nale¿ycie nagrodzony za swoje dzia³ania. W przeciwieñstwie do niektórych, doceniam wsparcie moich z³odziei bardziej, ni¿ mo¿na zak³adaæ.~ ~Zostaniesz, oczywiœcie, nale¿ycie nagrodzona za swoje dzia³ania. W przeciwieñstwie do niektórych, doceniam wsparcie moich z³odziei bardziej, ni¿ mo¿na zak³adaæ.~
@271  = ~Mo¿esz znaleŸæ zastosowanie dla tego pierœcienia: jeden z wielu przedmiotów, które "naby³em" z up³ywem czasu.~
@272  = ~Teraz jesteœmy sobie równi, <CHARNAME>, i wygl¹da na to, ¿e nie jestem w stanie pomóc ci zniszczyæ Bodhi w takim stopniu, w jakim bym sobie ¿yczy³. Musisz zabiæ j¹ sam<PRO_HESHE>. Mimo to, ¿yczê ci powodzenia.~
@273  = ~Musimy jednak skierowaæ nasz¹ uwagê na inne sprawy. Kiedy bêdziesz gotów, udaj... udaj siê na cmentarz i wejdŸ do grobowców. Moi najlepsi zabójcy spotkaj¹ ciê tam i mam nadziejê, ¿e wystarcz¹.~ ~Musimy jednak skierowaæ nasz¹ uwagê na inne sprawy. Kiedy bêdziesz gotowa, udaj... udaj siê na cmentarz i wejdŸ do grobowców. Moi najlepsi zabójcy spotkaj¹ ciê tam i mam nadziejê, ¿e wystarcz¹.~
@274  = ~Równie¿ inne dobre wieœci dotar³y do moich uszu. Wiêc... nareszcie, Bodhi nie ¿yje, prawda? Jestem bardzo zadowolony. Z³odzieje Cienia nareszcie mog¹ odetchn¹æ z ulg¹. Dobra robota, <CHARNAME>.~
@275  = ~Teraz jednak, <CHARNAME>, jest coœ innego, czego od ciebie potrzebujê. Wygl¹da na to, ¿e uporasz siê z jednym wrogiem, inny wystawia swój ³eb.~
@276  = ~Teraz jednak, musisz skierowaæ swoj¹ uwagê na inne aktualne zagro¿enie. Jak wspomnia³em, Bodhi powróci³a do miasta.~
@277  = ~Teraz jednak muszê ciê prosiæ, byœ mnie opuœci³<PRO_HESHE>, trzeba mi bowiem zaj¹æ siê napraw¹ spustoszeñ spowodowanych tym zamachem.~
@278  = ~<CHARNAME>, doceniam twoj¹ pomoc w ostatnich wydarzeniach. Muszê jednak ciê prosiæ, byœ mnie opuœci³<PRO_HESHE>, trzeba mi bowiem zaj¹æ siê napraw¹ spustoszeñ spowodowanych tym zamachem.~
@279  = ~<CHARNAME>, powiedzia³em ci o swojej decyzji. Musisz zabiæ Bodhi, lecz bez mojej pomocy, nie mam bowiem wystarczaj¹cych si³. Powodzenia.~
@280  = ~Jesteœ pewien, ¿e nie mogê ciê przekonaæ, byœ zmieni³ swe zdanie?~
@281  = ~Byæ mo¿e zmienisz zdanie. Przyby³em, by ostrzec ciê o spisku Mae'Vara i Larella na twoje ¿ycie.~ ~Byæ mo¿e zmienisz zdanie. Przyby³am, by ostrzec ciê o spisku Mae'Vara i Larella na twoje ¿ycie.~
@282  = ~W porz¹dku. Zrobiê to bez twojej pomocy.~
@283  = ~Kiedy bêdziesz gotów, udaj... udaj siê na cmentarz i wejdŸ do grobowców. Moi najlepsi zabójcy spotkaj¹ ciê tam i mam nadziejê, ¿e wystarcz¹.~ ~Kiedy bêdziesz gotowa, udaj... udaj siê na cmentarz i wejdŸ do grobowców. Moi najlepsi zabójcy spotkaj¹ ciê tam i mam nadziejê, ¿e wystarcz¹.~
@284  = ~To mo¿e poczekaæ. Przyby³em, by ostrzec ciê o spisku Mae'Vara i Larella na twoje ¿ycie.~ ~To mo¿e poczekaæ. Przyby³am, by ostrzec ciê o spisku Mae'Vara i Larella na twoje ¿ycie.~
@285  = ~Bardzo dobrze, ju¿ idê.~
@286  = ~Nie oddychaj jeszcze z ulg¹. Przyby³em, by ostrzec ciê o spisku Mae'Vara i Larella na twoje ¿ycie.~ ~Nie oddychaj jeszcze z ulg¹. Przyby³am, by ostrzec ciê o spisku Mae'Vara i Larella na twoje ¿ycie.~
@287  = ~W rzeczy samej. S¹dzê, ¿e nie musisz siê ju¿ wiêcej obawiaæ konkurencyjnych gildii.~
@288  = ~Porozmawiaj z Aranem, <CHARNAME>. Nie bêdê omawiaæ z tob¹ swoich spraw.~
@289  = ~Ach, Mae'Var przys³a³ ciê wiêc jako wzmocnienie. Nie przejmuj siê, mo¿emy tu swobodnie rozmawiaæ, poniewa¿ upewni³em siê, ¿e nie mo¿e nas pods³uchaæ ¿aden z tych, którzy s¹ nadal lojalni wzglêdem Linvaila.~ [d0night2]
@290 = ~Dobrze. Wobec tego co trzeba teraz uczyniæ?~
@291 = ~Naprawdê wierzysz, ¿e masz tu jak¹kolwiek szansê powodzenia?~
@292 = ~To niedorzeczne. Nie wezmê w tym udzia³u!~
@293 = ~Jak mówiliœmy, pod nami bitwa ju¿ siê rozpoczê³a. Twoim zadaniem jest po prostu wsparcie walcz¹cych wszêdzie, gdzie to mo¿liwe i wyr¹banie sobie drogi do samego Linvaila. Zabij go, gdy ju¿ do niego dotrzesz.~
@294 = ~Miejmy nadziejê. <CHARNAME>, mamy tu wiêksze wsparcie ni¿ ci siê wydaje. A teraz ruszaj... bitwa ju¿ siê zaczê³a.~
@295 = ~Twoim zadaniem jest po prostu wsparcie walcz¹cych wszêdzie, gdzie to mo¿liwe i wyr¹banie sobie drogi do samego Linvaila. Zabij go, gdy ju¿ do niego dotrzesz.~
@296 = ~Wobec tego nie mo¿emy dopuœciæ, abyœ pozosta³<PRO_HESHE> przy ¿yciu.~
@297 = ~Doskonale. Jak ju¿ wiesz, do kryjówki Linvaila mo¿na siê dostaæ przez sekretne drzwi na ni¿szym poziomie. A teraz ruszaj, nie ma czasu do stracenia!~
@298 = ~<CHARNAME>, skoro zabezpieczyliœmy ten teren, musisz ruszaæ naprzód. Do kryjówki Linvaila wejdziesz przez ukryte drzwi. Nie martw siê, bêdziemy tu¿ za tob¹.~
@299 = ~Zaprawdê wspaniale! Po upadku Linvaila przejêliœmy kontrolê nad dzia³alnoœci¹ Z³odziei Cienia w Athkatli. <CHARNAME>, muszê ci podziêkowaæ za twoje wsparcie!~ [d0night3]
@300 = ~Powiedzia³eœ, ¿e bêdziesz tu¿ za mn¹. Gdzie by³eœ?~
@301 = ~I co teraz?~
@302 = ~Kiedy otrzymam nagrodê?~
@303 = ~Ach, mhm, tak. Musia³em zaj¹æ siê pewnymi bardzo wa¿nymi sprawami, co nieznacznie mnie opóŸni³o. Ale i tak poradzi³eœ sobie wyœmienicie.~ ~Ach, mhm, tak. Musia³em zaj¹æ siê pewnymi bardzo wa¿nymi sprawami, co nieznacznie mnie opóŸni³o. Ale i tak poradzi³aœ sobie wyœmienicie.~
@304 = ~Nie w¹tpiê, ¿e po œmierci Linvaila, wiêkszoœæ z³odziei zrozumie, ¿e lepiej siê do nas przy³¹czyæ. Lojalnoœæ to rzadka cecha poœród Z³odziei Cienia.~
@305 = ~Tymczasem jest jeszcze jedno zadanie, którym chcia³bym ciê obarczyæ.~
