@2    = ~Przepraszam, Rayicu. Jednak muszê z tob¹ pilnie porozmawiaæ.~
@3    = ~Ach, uwin¹³eœ siê ze s³ugami, którzy zatrzymuj¹ ka¿dego innego pospolitego ¿ebraka okradaj¹cego mój dom? Zatem sam ukarzê ciê za twoj¹ bezczelnoœæ!~ ~Ach, uwinê³aœ siê ze s³ugami, którzy zatrzymuj¹ ka¿dego innego pospolitego ¿ebraka okradaj¹cego mój dom? Zatem sam ukarzê ciê za twoj¹ bezczelnoœæ!~
@4    = ~Tak jakbym by³ poinformowany o ka¿dej przywleczonej sfiksowanej przyb³êdzie. Ba! Nie bêdê znosi³ takiej bezczelnoœci!~
@5    = ~Ach, wysz³o to na dobre. Mo¿e twoja ingerencja mimo wszystko by³a przydatna. Oczywiœcie, to twoje z³oto w zamian i jeszcze trochê, za twoje zaanga¿owanie. A teraz odejdŸ! Mam robotê, któr¹ muszê siê zaj¹æ.~
@6    = ~Ach, Edwinie, jak to mi³o z twojej strony, ¿e siê do nas przy³¹czasz. Zaskoczony, ¿e mnie widzisz? Pozwól mi na wstêpie odzyskaæ mój sygnet. Wiedzia³em, ¿e czar telekinetycznej pamiêci dowiedzie swej wartoœci.~
@7    = ~Doskona³a robota, ¿e go tu przyprowadzasz. A teraz, czas daæ mu to, na co zas³u¿y³!~
@8    = ~Ach, Edwinie, jak to mi³o z twojej strony, ¿e siê do nas przy³¹czasz. Zaskoczony, ¿e mnie widzisz?~
@9    = ~Doskona³a robota, ¿e go tu przyprowadzasz. Ufam, i¿ masz pierœcieñ. Ach, wspaniale. Oczywiœcie, to twoje z³oto w zamian.~
@10   = ~Doskona³a robota, ¿e go tu przyprowadzasz. Ale gdzie pierœcieñ? Nie mog³eœ go zgubiæ.~ ~Doskona³a robota, ¿e go tu przyprowadzasz. Ale gdzie pierœcieñ? Nie mog³aœ go zgubiæ.~
@11   = ~Phi! Idioci, wy wszyscy! Poczujcie mój gniew!~
@12   = ~Edwin? Co tu siê dzieje?!~
