@395 = ~Nie zamierzam odwalaæ za ciebie ¿adnej brudnej roboty.~
@396 = ~Ach, <CHARNAME>, martwi³em siê, ¿e ju¿ nie przyjdziesz. G³ówny Inspektor Brega, do us³ug. Z ramienia Rady zajmujê siê sprawami kryminalnymi w tym mieœcie. I uwierz mi, ¿e jest ich ca³kiem sporo.~
@397 = ~Ach, <CHARNAME>, poinformowano mnie, ¿e siê tu nie pojawisz. G³ówny Inspektor Brega, do us³ug. Z ramienia Rady zajmujê siê sprawami kryminalnymi w tym mieœcie. I uwierz mi, ¿e jest ich ca³kiem sporo.~
@398 = ~Ach, <CHARNAME>, mia³em nadziejê, ¿e przyjdziesz. Zastanawiasz siê zapewne, dlaczego ciê wezwa³em.~
@399 = ~Jak wiesz, z ramienia Rady zajmujê siê sprawami kryminalnymi w tym mieœcie. I jest pewna szczególna kwestia, która zaprz¹ta moj¹ uwagê ju¿ od jakiegoœ czasu.~
@400 = ~Ach, <CHARNAME>, martwi³em siê, ¿e ju¿ nie przyjdziesz. Zreszt¹ niewa¿ne. Zastanawiasz siê zapewne, dlaczego ciê wezwa³em.~
@401 = ~Ach, <CHARNAME>, poinformowano mnie, ¿e siê tu nie pojawisz. Zreszt¹ niewa¿ne. Zastanawiasz siê zapewne, dlaczego ciê wezwa³em.~
@402 = ~<CHARNAME>, chcielibyœmy, byœ nam pomóg³. Zale¿y nam jednak na czasie. Im d³u¿ej bêdziemy zwlekaæ, tym wiêksza szansa, ¿e nasz plan siê nie powiedzie.~ ~<CHARNAME>, chcielibyœmy, byœ nam pomog³a. Zale¿y nam jednak na czasie. Im d³u¿ej bêdziemy zwlekaæ, tym wiêksza szansa, ¿e nasz plan siê nie powiedzie.~
@403 = ~Doskonale. Nasz wywiad donosi, ¿e to Aran Linvail przewodzi Z³odziejom Cienia w Athkatli. Wyeliminowanie go i uwolnienie bezprawnie przetrzymywanych przez niego wiêŸniów powinno wystarczyæ.~
@404 = ~Niestety nie mogê zapewniæ ci dostatecznego wsparcia stra¿ników miejskich. Wyœlemy kilku, by pomogli ci wedrzeæ siê do siedziby z³odziei, ale reszta zale¿eæ bêdzie ju¿ tylko do ciebie.~
@405 = ~Sugerujê, byœ nie traci³<PRO_HESHE> wiêcej czasu. Schronienie Linvaila znajduje siê w Dokach, w podziemiach du¿ego pomarañczowego budynku. Moi ludzie bêd¹ tam na ciebie czekaæ.~
@406 = ~Uzbieram ile siê tylko da, ale bez wsparcia Rady fundusze nie bêd¹ przesadnie du¿e. Nie zamartwiaj siê tym jednak, zostaniesz odpowiednio wynagrodzony.~ ~Uzbieram ile siê tylko da, ale bez wsparcia Rady fundusze nie bêd¹ przesadnie du¿e. Nie zamartwiaj siê tym jednak, zostaniesz odpowiednio wynagrodzona.~
@407 = ~Zrobiê to.~
