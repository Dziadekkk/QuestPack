@307 = ~Doœæ ju¿ mam twoich zadañ. ZnajdŸ sobie kogoœ innego do odwalania brudnej roboty!~
@308 = ~Chyba zdajesz ju¿ sobie sprawê z tego, jak bardzo obecne wydarzenia zmieniaj¹ uk³ad si³ w Athkatli. Wiesz, ¿e s³u¿ê interesom Nocnych Masek, z którymi Mae'Var spiskowa³, by przej¹æ w³adzê Linvaila.~
@309 = ~Ale, teraz gdy uda³o siê ju¿ to osi¹gn¹æ, Mae'Var nie jest nam ju¿ wiêcej potrzebny. Sta³ siê tylko kolejn¹ przeszkod¹ w naszych planach. Musisz go zatem usun¹æ w dowolny, byle skuteczny sposób.~
@310 = ~Myœlê, ¿e zamiast tego zabijê ciebie!~
@311 = ~Tak, jak mówisz. Uwa¿aj go za martwego.~
@312 = ~Zapewniam ciê, ¿e znajdê. A w takim razie nie jesteœ mi ju¿ wiêcej potrzebny. ¯egnaj, <CHARNAME>. W drodze powrotnej trafisz na odpowiednie towarzystwo.~ ~Zapewniam ciê, ¿e znajdê. A w takim razie nie jesteœ mi ju¿ wiêcej potrzebna. ¯egnaj, <CHARNAME>. W drodze powrotnej trafisz na odpowiednie towarzystwo.~
@313 = ~Och, nie zamierzam ci na to pozwoliæ. ¯egnaj, <CHARNAME>. W drodze powrotnej trafisz na odpowiednie towarzystwo.~
@314 = ~Wróæ tutaj, gdy Mae'Var przestanie nam ju¿ zawadzaæ. Zostaniesz wtedy wynagrodzony za swoje wysi³ki.~ ~Wróæ tutaj, gdy Mae'Var przestanie nam ju¿ zawadzaæ. Zostaniesz wtedy wynagrodzona za swoje wysi³ki.~
@315 = ~<CHARNAME>... cierpliwoœci. Mam dla ciebie ostatnie zadanie do wykonania, zanim odbierzesz swoj¹ nagrodê.~
@316 = ~Ostrzegaj¹c Linvaila o naszych planach, opóŸni³eœ ca³¹ operacjê. Jedyne, na co mo¿emy teraz liczyæ, to ¿e uda nam siê go przyt³oczyæ i pokonaæ nawet bez elementu zaskoczenia.~ [d0night4] ~Ostrzegaj¹c Linvaila o naszych planach, opóŸni³aœ ca³¹ operacjê. Jedyne, na co mo¿emy teraz liczyæ, to ¿e uda nam siê go przyt³oczyæ i pokonaæ nawet bez elementu zaskoczenia.~ [d0night4]
@317 = ~Wiêc Linvail jest martwy. Twoja metoda by³a ryzykowna, i ja sam bym takiej nie wybra³, ale uda³o ci siê mimo wszystko.~ [d0night5]
@318 = ~Po upadku Linvaila przejêliœmy kontrolê nad dzia³alnoœci¹ Z³odziei Cienia w Athkatli. <CHARNAME>, muszê ci podziêkowaæ za twoje wsparcie!~
@319 = ~Poœpiesz siê z zabiciem Mae'Vara. Wkrótce dowie siê o sukcesie, który tu odnieœliœmy.~
@320 = ~Wróci³eœ! Jakie s³owa przynosisz o naszej sprawie?~ ~Wróci³aœ! Jakie s³owa przynosisz o naszej sprawie?~
@321 = ~Linvail nie ¿yje. I ty tak¿e!~
@322 = ~Zabi³em Linvaila, a Larell poprosi³ mnie, bym zabi³ i ciebie.~ ~Zabi³am Linvaila, a Larell poprosi³ mnie, bym zabi³a i ciebie.~
@324 = ~To niezbyt zaskakuj¹cy rozwój wypadków. Có¿, teraz siê przekonamy, jaki skutek przynios¹ moje przygotowania!~
@325 = ~Taka sytuacja nie jest mi obca. Dlaczego wiêc tym razem ujawniasz mi swoje plany?~
@326 = ~By mieæ wiêcej frajdy z pozabijania was wszystkich.~
@327 = ~Bo nie zamierzam wykonywaæ jego poleceñ.~
@328 = ~Poniewa¿ Larell ju¿ nie ¿yje.~
@329 = ~<CHARNAME>, wobec tego musisz raz jeszcze wyeliminowaæ mojego rywala. Zabij Larella, ale uwa¿aj, bo z Nocnymi Maskami niebezpiecznie jest zadzieraæ. Wiem coœ o tym.~
@330 = ~Co masz mi do powiedzenia? Czy Larell jest martwy?~
@331 = ~Znowu zmieni³em zdanie. Zginiesz zamiast niego!~ ~Znowu zmieni³am zdanie. Zginiesz zamiast niego!~
@332 = ~Znowu zmieni³em zdanie. Ty równie¿ zginiesz!~ ~Znowu zmieni³am zdanie. Ty równie¿ zginiesz!~
@333 = ~Jeszcze nie. Wrócê, gdy tylko bêdzie.~
