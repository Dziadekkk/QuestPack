@95 = ~Cierpimy ostatnio na niedobór ludzi, wiêc zaakceptujemy ka¿dego, kto potrafi walczyæ.~
@96 = ~A sk¹d ten niedobór?~
@97 = ~W³aœciwie to trochê ciê oszuka³em. To nie ja chcê siê przy³¹czyæ, tylko mój przyjaciel.~ ~W³aœciwie to trochê ciê oszuka³am. To nie ja chcê siê przy³¹czyæ, tylko mój przyjaciel.~
@98 = ~Rozumiem. Teraz jednak muszê ju¿ iœæ.~
@99 = ~Akceptujemy w³aœciwie ka¿dego, kto potrafi walczyæ. Przyœlij do mnie swojego przyjaciela, a bêdê ci bardzo wdziêczna. Mi³ego dnia.~
@100 = ~Dobrze. Wróæ jednak, jeœli zmienisz zdanie.~
@101 = ~Nie chcê nikogo zniechêcaæ do wst¹pienia do stra¿y, ale mieliœmy ostatnio zaskakuj¹c¹ iloœæ zaginiêæ na s³u¿bie. Szczególnie w nocy. Potrzebujemy ka¿dego jednego ¿o³nierza, którego tylko mo¿emy dostaæ.~
@102 = ~Myœla³aœ mo¿e o wprowadzeniu poboru? To by rozwi¹za³o problem niedoboru.~
@103 = ~Zaginiêcia? Nagle przesta³em byæ tym wszystkim zainteresowany. Zapomnij, ¿e w ogóle wspomina³em o stra¿y.~ ~Zaginiêcia? Nagle przesta³am byæ tym wszystkim zainteresowana. Zapomnij, ¿e w ogóle wspomina³am o stra¿y.~
@104 = ~Nawet w czasach wojen nie byliœmy zmuszeni do wprowadzania poboru. I wola³abym, ¿eby tak zosta³o.~
@105 = ~Có¿, œwiadomoœæ, ¿e zg³osi³bym siê na ochotnika, tylko po to, by zostaæ zabitym, nie jest dla mnie jak¹œ szczególn¹ zachêt¹. Nagle przesta³em byæ tym wszystkim zainteresowany. Zapomnij, ¿e w ogóle wspomina³em o stra¿y.~ ~Có¿, œwiadomoœæ, ¿e zg³osi³abym siê na ochotnika, tylko po to, by zostaæ zabit¹, nie jest dla mnie jak¹œ szczególn¹ zachêt¹. Nagle przesta³am byæ tym wszystkim zainteresowana. Zapomnij, ¿e w ogóle wspomina³am o stra¿y.~
@106 = ~Œwietnie. W ka¿dym razie, jeœli ja nie by³bym jednak zainteresowany przy³¹czeniem siê do stra¿y, to czy mój przyjaciel móg³by?~ ~Œwietnie. W ka¿dym razie, jeœli ja nie by³abym jednak zainteresowana przy³¹czeniem siê do stra¿y, to czy mój przyjaciel móg³by?~
@107 = ~Rozumiem. Ale w³aœciwie to trochê ciê oszuka³em. To nie ja chcê siê przy³¹czyæ, tylko mój przyjaciel.~ ~Rozumiem. Ale w³aœciwie to trochê ciê oszuka³am. To nie ja chcê siê przy³¹czyæ, tylko mój przyjaciel.~
@108 = ~No to wasza strata. Tymczasem ciê opuszczê.~
@109 = ~Ach, to o to chodzi. Przyœlij do mnie swojego przyjaciela, a bêdê ci bardzo wdziêczna. Mi³ego dnia.~
@110 = ~Reynald de Chatillon jest niew¹tpliwie godnym uzupe³nieniem stra¿y miejskiej. Jestem ci wdziêczna za skierowanie go do mnie.~
@111 = ~Czy jest jeszcze coœ, w czym mog³abym ci pomóc?~
@112 = ~Reynald de Chatillon? Czy to mo¿liwe? Nie sprzymierzy³eœ siê czasem z tym zdrajc¹ Anargiem?~
@113 = ~Opuœci³em Anarga, gdy¿ dostrzeg³em, jak b³êdna jest droga, któr¹ obra³. Zreszt¹ to nie ma znaczenia, teraz gdy stajemy przeciwko wspólnemu wrogowi.~
@114 = ~A wiêc walcz dzielnie, Reynaldzie. Wszystkie konflikty mo¿emy na razie zostawiæ za sob¹.~
@115 = ~Ach, <CHARNAME>, mi³o ciê widzieæ. Powiedziano mi, ¿e sam Anarg chcia³by siê z tob¹ spotkaæ.~
@116 = ~Moje uszanowanie, przyjacielu. Jestem niezmiernie wdziêczny za tw¹ pomoc przeciwko tym psom i rad bym pozna³ twe imiê, o ile zechcesz siê nim podzieliæ.~ ~Moje uszanowanie, przyjació³ko. Jestem niezmiernie wdziêczny za tw¹ pomoc przeciwko tym psom i rad bym pozna³ twe imiê, o ile zechcesz siê nim podzieliæ.~ [reynald1]
@117 = ~Wróci³eœ, panie? Czy¿byœ zmieni³ zdanie? Zamierzasz odzyskaæ dla mnie puchar Anarga tak, jak prosi³em?~ ~Wróci³aœ, pani? Czy¿byœ zmieni³a zdanie? Zamierzasz odzyskaæ dla mnie puchar Anarga tak, jak prosi³em?~ [reynald2]
@118 = ~Wiêc wracasz, <LADYLORD>... ale nie masz ze sob¹ pucharu Anarga. Czy¿by coœ posz³o nie tak?~ [reynald3]
@119 = ~Wiêc wracasz, <LADYLORD>. Uda³o ci siê? Masz ze sob¹ puchar Anarga?~ [reynald4]
@120 = ~Hej, ty... przygl¹dasz siê, jak walczymy, ale nawet nie kiwniesz palcem, ¿eby nam pomóc. NajwyraŸniej masz do nas jak¹œ sprawê. Mogê zapytaæ o jej naturê? I o twoje imiê przy okazji?~ [reynald5]
@121 = ~Wiêc chcia³<PRO_HESHE>byœ siê do nas przy³¹czyæ? Moi ludzie bardzo dobrze o tobie mówili.~
@122 = ~Byæ mo¿e mówi¹ o mnie dobrze, ale muszê ci siê szczerze przyznaæ, ¿e was ok³ama³em. Jestem tu, by pomówiæ o czymœ innym, ni¿ przy³¹czenie siê do was.~ ~Byæ mo¿e mówi¹ o mnie dobrze, ale muszê ci siê szczerze przyznaæ, ¿e was ok³ama³am. Jestem tu, by pomówiæ o czymœ innym, ni¿ przy³¹czenie siê do was.~
@123 = ~Nie, Anargu. To Zakon mnie tu przys³a³. Kazali mi rozprawiæ siê z twoj¹ grup¹, ale zamiast tego chcê ci zaproponowaæ, byœ siê podda³ i przyst¹pi³ do negocjacji.~
@124 = ~Nie zamierzam zawracaæ, skoro zaszed³em ju¿ tak daleko. Tak, przy³¹czê siê do was.~ ~Nie zamierzam zawracaæ, skoro zasz³am ju¿ tak daleko. Tak, przy³¹czê siê do was.~
@125 = ~Anarg? W imiê Zakonu, nadszed³ twój czas!~
@126 = ~Anarg? Nareszcie. Czas umieraæ!~
@127 = ~Ju¿ nic, niewa¿ne.~
@128 = ~Zdradzi³<PRO_HESHE>byœ nas dla tego odszczepieñca, Anarga? <CHARNAME>, srogo siê co do ciebie pomyli³em. Powinniœmy broniæ Zakonu zawsze, gdy to konieczne!~
@129 = ~<CHARNAME>, jest ktoœ, kto chcia³by siê z tob¹ spotkaæ. Œledziliœmy twoje poczynania i byliœmy œwiadkami twojego upadku. Wiedz, ¿e Zakon jest niestrudzony w wymierzaniu sprawiedliwoœci.~
@130 = ~Jeœli chcesz, to mo¿esz do³¹czyæ do innych, podobnych tobie. Znajdziesz nas w pó³nocno wschodniej czêœci Dzielnicy mostów.~
@131 = ~Nigdy nie do³¹czê do ¿adnych upad³ych szumowin! Pozosta³a mi jeszcze odrobina honoru!~
@132 = ~Mój upadek by³ niezas³u¿ony i szukam dla siebie odkupienia. Nie ma dla mnie miejsca w twoich zamys³ach.~
@133 = ~Ciekawa propozycja. Mo¿liwe, ¿e w najbli¿szym czasie z³o¿ê ci wizytê.~
@134 = ~Przyjdê, ale lepiej uwa¿aj, ¿eby nie okaza³o siê to dla mnie strat¹ czasu.~
@135 = ~Obawiam siê, ¿e jestem teraz trochê zbyt zajêty. Jednak jestem pewien, ¿e beze mnie bêdziecie siê bawiæ równie dobrze.~ ~Obawiam siê, ¿e jestem teraz trochê zbyt zajêta. Jednak jestem pewna, ¿e beze mnie bêdziecie siê bawiæ równie dobrze.~
@136 = ~Tak, jak i nam. Prze³knij swoj¹ g³upi¹ dumê i do³¹cz do nas.~
@137 = ~G³upot¹ jest szukaæ odkupienia w oczach Zakonu. Otwieraj¹ siê przed tob¹ inne drogi do wype³nienia obowi¹zków... inne sprawy, którym mo¿esz s³u¿yæ. Prze³knij swoj¹ g³upi¹ dumê i do³¹cz do nas.~
@138 = ~Ucieszy nas twoje towarzystwo. Dla wielu z nas honorem bêdzie spotkaæ kogoœ tak... nies³awnego jak ty.~
