@0 = ~Naprawdê przykro patrzeæ, jak upada taki honorowy m¹¿. Byæ mo¿e jest jeszcze dla ciebie nadzieja, Reynaldzie, nawet jeœli nie jako rycerza.~
@1 = ~Naprawdê przykro patrzeæ, jak upada taki honorowy m¹¿. Ale tak to ju¿ jest w Zakonie; sam honor nie wystarcza.~
@2 = ~Kolejny odrzucony przez Zakon. Bydlaki! Nie ma siê co dziwiæ, ¿e tak wielu przy³¹czy³o siê do Anarga.~
@3 = ~Choæ jego upadek by³ tragiczny, to nie w¹tpiê, ¿e pozosta³ wierny rycerskim cnotom. <CHARNAME>, miejmy nadziejê, ¿e nie ulegnie jak Anarg innym d¹¿eniom.~
@4 = ~A wiêc sta³o siê, Anarg pad³. Dziêkujê ci, <PRO_LADYLORD>, za wskazanie mi drogi.~ [reynald6]
@5 = ~Tylko co dalej? Nie mam ¿adnego celu, nie mam przewodnika. W któr¹ stronê powinienem siê zwróciæ?~
@6 = ~Bêdziesz siê teraz rozwodzi³ nad swoim upadkiem?~
@7 = ~Mo¿esz przy³¹czyæ siê do mnie, jeœli chcesz.~
@8 = ~Jakiej drogi dla siebie szukasz, Reynaldzie?~
@9 = ~Jestem pewna, ¿e jest wiele rzeczy, po które taki przystojny m³ody mê¿czyzna jak ty móg³by siêgn¹æ.~
@10 = ~A co mnie to obchodzi? OdejdŸ wiêc, upad³y, i radŸ sobie sam.~
@11 = ~A co mnie to obchodzi? OdejdŸ wiêc i radŸ sobie sam.~
@12 = ~Anarg nie chcia³by, ¿ebym dzieli³ siê szczegó³ami i zapewne mia³ ku temu swoje powody, ale niezale¿nie od nich wola³bym tego nie roztrz¹saæ.~ [reynald7]
@13 = ~Doœæ powiedzieæ, ¿e pomyli³em siê w moim os¹dzie. S³ysza³eœ zapewne od Rindusa o tym, ¿e uwik³a³em siê w zwi¹zek z Celestine.~ ~Doœæ powiedzieæ, ¿e pomyli³em siê w moim os¹dzie. S³ysza³aœ zapewne od Rindusa o tym, ¿e uwik³a³em siê w zwi¹zek z Celestine.~
@14 = ~Ona... nie by³a taka, jaka wierzy³em, ¿e jest i to przez ni¹ wydalono mnie z Zakonu. Nie trzeba mówiæ nic wiêcej.~
@15 = ~To dlaczego nie zemœcisz siê na tej zdzirze?~
@16 = ~Wspó³czujê ci niezmiernie. Powiedz, jakiej drogi teraz dla siebie szukasz?~
@17 = ~W ka¿dym b¹dŸ razie, jestem pewna, ¿e jest wiele rzeczy, po które taki przystojny m³ody mê¿czyzna jak ty móg³by siêgn¹æ.~
@18 = ~¯a³osne. OdejdŸ wiêc, upad³y, i radŸ sobie sam.~
@19 = ~¯a³osne. OdejdŸ wiêc i radŸ sobie sam.~
@20 = ~Szczerego jesteœ serca, ale twoje postêpowanie nie wró¿y niczego dobrego. Jestem ci wdziêczny za tê propozycjê, ale wolê j¹ jednak odrzuciæ... przynajmniej na razie.~
@21 = ~Rozumiem. Jestem pewna, ¿e jest wiele rzeczy, po które taki przystojny m³ody mê¿czyzna jak ty móg³by siêgn¹æ.~
@22 = ~Niech bêdzie. OdejdŸ wiêc, upad³y, i radŸ sobie sam.~
@23 = ~Niech bêdzie. OdejdŸ wiêc i radŸ sobie sam.~
@24 = ~Dostrzegam w tobie idea³y, którym sam by³em kiedyœ oddany. Jednak mój upadek by³ w koñcu czymœ spowodowany i tak to ju¿ zostanie. Jestem ci wdziêczny za tê propozycjê, ale wolê j¹ jednak odrzuciæ... przynajmniej na razie.~
@25 = ~Jesteœ mê¿czyzn¹ bliskim memu sercu, panie. Obawiam siê jednak, ¿e droga, któr¹ kroczysz, nie jest dla mnie. Jestem ci wdziêczny za tê propozycjê, ale wolê j¹ jednak odrzuciæ... przynajmniej na razie.~ ~Jesteœ kobiet¹ blisk¹ memu sercu, pani. Obawiam siê jednak, ¿e droga, któr¹ kroczysz, nie jest dla mnie. Jestem ci wdziêczny za tê propozycjê, ale wolê j¹ jednak odrzuciæ... przynajmniej na razie.~
@26 = ~Wygl¹da na to, ¿e nie podzielamy tych samych zasad, <PRO_LADYLORD>, i obawiam siê, ¿e podró¿owanie z tob¹ znowu Ÿle siê dla mnie skoñczy. Jestem ci wdziêczny za tê propozycjê, ale wolê j¹ jednak odrzuciæ... przynajmniej na razie.~
@27 = ~Nie jestem ju¿ tym cz³owiekiem honoru, za którego siê kiedyœ mia³em. Mój upadek jest nieodwracalny, ale mogê przynajmniej staraæ siê dzia³aæ z czystym sumieniem.~
@28 = ~Mo¿e móg³byœ przy³¹czyæ siê do stra¿y miejskiej?~
@29 = ~Móg³byœ zostaæ poszukiwaczem przygód, jak ja?~
@30 = ~Spaczone runy szukaj¹ zapewne nowych stra¿ników.~
@31 = ~Rozejrzê siê po okolicy, czy czegoœ dla ciebie nie znajdê.~
@32 = ~Jak uwa¿asz. To twoja droga... zrobisz, jak zechcesz.~
@33 = ~Zbytnio mi schlebiasz, <PRO_LADYLORD>. Nie obra³bym te¿ drogi w oparciu, o takie walory.~
@34 = ~Tak zrobiê, <PRO_LADYLORD>. Nie wiem, jak dalej potoczy siê moje ¿ycie, ale modlê siê, bym móg³ siê odkupiæ... przynajmniej w moich w³asnych oczach.~ [reynald8]
@35 = ~Nie obwiniam jej za to, co zrobi³a. I jak ju¿ prosi³em, nie mówmy o tym wiêcej.~
@36 = ~To mo¿e móg³byœ przy³¹czyæ siê do stra¿y miejskiej?~
@37 = ~Mo¿e zostaniesz, jak ja, poszukiwaczem przygód?~
@38 = ~Có¿, Spaczone runy szukaj¹ zapewne nowych stra¿ników.~
@39 = ~W takim razie rozejrzê siê po okolicy, czy czegoœ dla ciebie nie znajdê.~
@40 = ~Niech bêdzie. To twoja droga... zrobisz, jak zechcesz.~
@41 = ~Tak, to poci¹gaj¹cy pomys³; s³u¿y³bym wtedy s³usznej sprawie. Dziêkujê ci, <PRO_LADYLORD>.~ [reynald9]
@42 = ~Tylko jak mia³bym siê do nich przy³¹czyæ? Zaakceptuj¹ mnie, znaj¹c moj¹ przesz³oœæ?~
@43 = ~Wcale nie musz¹ poznawaæ twojej przesz³oœci.~
@44 = ~Jestem pewien, ¿e nie bêd¹ mieli ¿adnych uprzedzeñ.~ ~Jestem pewna, ¿e nie bêd¹ mieli ¿adnych uprzedzeñ.~
@45 = ~Porozmawiam z nimi i zobaczê, co mi siê uda za³atwiæ.~
@46 = ~W¹tpiê, ¿ebym pasowa³ do takiej roli. Potrzebujê raczej jakiegoœ szlachetnego celu.~
@47 = ~Nigdy nie s³ysza³em o Spaczonych runach, ale i tak nie interesuje mnie praca stra¿nika dla jakiejœ zamo¿nej organizacji.~
@48 = ~Nie zamierzam tu zostaæ, <PRO_LADYLORD>. Wszystko tutaj przypomina mi o przesz³oœci. Odejdê i zobaczê, dok¹d ¿ycie mnie zawiedzie.~ [reynal10]
@49 = ~Wobec tego, mo¿e zechcesz porozmawiaæ z nimi w moim imieniu?~
@50 = ~Tak, zrobiê to.~
@51 = ~Nie. Nie jestem tu po to, by dostarczaæ komuœ twoje wiadomoœci.~
@52 = ~Dziêkujê, <PRO_LADYLORD>. Chocia¿ wola³bym tego nie robiæ, przypuszczam, ¿e muszê tu zostaæ przez jakiœ czas i czekaæ na twój powrót.~ [reynal11]
@53 = ~Wobec tego podejrzewam, ¿e muszê sam sprawdziæ tê mo¿liwoœæ. Mo¿e to zrobiê, a mo¿e nie. Odejdê i zobaczê, dok¹d ¿ycie mnie zawiedzie.~ [reynal12]
@54 = ~Rozmawia³eœ z kimœ kompetentnym o moim wst¹pieniu do stra¿y miejskiej?~ ~Rozmawia³aœ z kimœ kompetentnym o moim wst¹pieniu do stra¿y miejskiej?~ [reynal13]
@55 = ~Tak, rozmawia³em z Sêdzi¹ Bylann¹.~ ~Tak, rozmawia³am z Sêdzi¹ Bylann¹.~
@56 = ~Nie, jeszcze nie.~
@57 = ~I co, rozpatrzy moj¹ proœbê?~
@58 = ~Poprosi³a byœ uda³ siê do niej na rozmowê, zanim podejmie decyzjê.~
@59 = ~Przykro mi, Reynaldzie. Po prostu nie jesteœ stworzony do s³u¿by w stra¿y miejskiej. Chyba musisz zostaæ tutaj.~
@60 = ~Poœpiesz siê wiêc, <PRO_LADYLORD>. Mam wra¿enie, ¿e ¿ycie ucieka mi miêdzy palcami, gdy nie s³u¿ê ¿adnemu celowi.~
@61 = ~Dziêkujê ci, panie. Natychmiast pójdê jej szukaæ w budynku Rady. Odda³eœ mi wielk¹ przys³ugê.~ ~Dziêkujê ci, pani. Natychmiast pójdê jej szukaæ w budynku Rady. Odda³aœ mi wielk¹ przys³ugê.~ [reynal14]
@62 = ~Nie ma sprawy, Reynaldzie.~
@63 = ~Nie bêdzie ¿adnej nagrody za moje wysi³ki?~
@64 = ~Wszystkiego dobrego, <CHARNAME>.~ [reynal15]
@65 = ~Obawiam siê, ¿e nie mam niczego, czym móg³bym ciê wynagrodziæ. Na zawsze pozostanê twoim d³u¿nikiem. Wierzê jednak, ¿e twoje sumienie zosta³o zaspokojone.~
@66 = ~<CHARNAME>! Tak myœla³em, ¿e tu ciê znajdê. Zakoñczmy ¿ywota tych nikczemnych potworów!~ [reynal16]
@67 = ~Doskonale. Tych stworów jest jednak o wiele wiêcej i musisz wyeliminowaæ je wszystkie.~ [reynal17]
@68 = ~Reynald? A co ty tutaj robisz?~
@69 = ~Dlaczego to ja muszê je eliminowaæ?~
@70 = ~Wobec tego zacznê jak najszybciej.~
@71 = ~Robiê wszystko, co w mojej mocy, by byæ wszêdzie tam, gdzie honor tego wymaga. Byæ mo¿e nie odnios³em sukcesu porównywalnego z twoim, ale przynajmniej próbowa³em.~
@72 = ~Wygl¹da na to, ¿e los nie potraktowa³ ciê jakoœ szczególnie Ÿle.~
@73 = ~Dlaczego to ja muszê eliminowaæ te potwory?~
@74 = ~Rozumiem. Có¿, wobec tego zajmê siê eksterminacj¹ tych potworów.~
@75 = ~Robiê wszystko, co w mojej mocy, by byæ wszêdzie tam, gdzie honor tego wymaga. Byæ mo¿e nie odnios³em jakiegoœ osza³amiaj¹cego sukcesu, ale przynajmniej próbowa³em.~
@76 = ~Sam sobie z nimi nie poradzê, panie. A ty przyby³eœ tutaj odpowiednio wyposa¿ony.~ ~Sam sobie z nimi nie poradzê, pani. A ty przyby³aœ tutaj odpowiednio wyposa¿ona.~
@77 = ~Niewa¿ne. Nie bêdê odwala³ dla ciebie ¿adnej brudnej roboty. Jestem tu tylko po to, by rozprawiæ siê z Bodhi i odejœæ. Jak chcesz, to mo¿esz tu potem posprz¹taæ.~
@78 = ~Wiêc nie zatrzymujmy siê tu d³u¿ej. ZnajdŸmy wejœcie do krypt pod nami.~
@79 = ~Wrêcz przeciwnie, <PRO_LADYLORD>, czu³em, ¿e do takiego ¿ycia nie by³em stworzony. Teraz przynajmniej mam jakiœ wybór.~
@80 = ~Ale nie zatrzymujmy siê tu d³u¿ej. ZnajdŸmy wejœcie do krypt pod nami.~
@81 = ~A wiêc ten stwór wreszcie pad³. Wygl¹da na to, ¿e uda³o mi siê zrobiæ tutaj coœ dobrego, <PRO_LADYLORD>. Teraz jednak odejdê, by znowu znikn¹æ. ¯egnaj.~ [reynal18]
@82 = ~Z kim powinienem rozmawiaæ na temat przyst¹pienia do stra¿y miejskiej?~ ~Z kim powinnam rozmawiaæ na temat przyst¹pienia do stra¿y miejskiej?~
@83 = ~Porozmawiaj z Bylann¹. Ja zajmujê siê tylko œledztwami w sprawach kryminalnych.~
@84 = ~A wiesz mo¿e, jakie s¹ wymagania, ¿eby przyst¹piæ do stra¿y?~
@85 = ~To pójdê siê z ni¹ rozmówiæ.~
@86 = ~Aha, rozumiem. Dziêkujê.~
@87 = ~Nie znam szczegó³ów, ale wiem, ¿e obecnie prawie ka¿dy zostaje przyjêty. Ciê¿ko dzisiaj o dobrych ludzi.~
@88 = ~To pójdê porozmawiaæ z Bylann¹.~
@89 = ~Brega poinformowa³ mnie, ¿e to z tob¹ powinienem rozmawiaæ o przyst¹pieniu do stra¿y miejskiej. Czy to prawda?~ ~Brega poinformowa³ mnie, ¿e to z tob¹ powinnam rozmawiaæ o przyst¹pieniu do stra¿y miejskiej. Czy to prawda?~
@90 = ~Powinieneœ porozmawiaæ ze mn¹. Dlaczego pytasz? Jesteœ zainteresowany przyst¹pieniem?~ ~Powinnaœ porozmawiaæ ze mn¹. Dlaczego pytasz? Jesteœ zainteresowana przyst¹pieniem?~
@91 = ~Tak, jestem. Jakie s¹ wymagania?~
